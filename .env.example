# Copy to .env for local runs, or set these in the Render dashboard. Never commit real values.
# --- required in production ---
DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
ADMIN_KEY=generate-with-openssl-rand-hex-24
APP_URL=https://getwheelsdown.com
NODE_ENV=production
# --- email (password reset) ---
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=Wheelsdown <no-reply@mail.getwheelsdown.com>
CONTACT_EMAIL=hello@getwheelsdown.com
# --- optional ---
VITE_OPERATOR_NAME=Your Company, LLC
MODERATE=0
SEED_MODE=starter        # demo | starter | none (only used when the database is empty)
SESSION_DAYS=90
PG_POOL_MAX=5
PGSSL=                   # disable | verify (default: TLS on, relaxed verification)
ADS_TXT=                 # e.g. google.com, pub-0000000000000000, DIRECT, f08c47fec0942fa0
# Local dev: leave DATABASE_URL unset to use the embedded database in ./.pglite
